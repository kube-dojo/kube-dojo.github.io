{
  "name": "kubedojo",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "NODE_DISABLE_COMPILE_CACHE=1 astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ tests/",
    "audit": "npm audit --omit=dev",
    "check": "npm run build && npm test && npm run lint && python3 scripts/check_site_health.py"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.3",
    "@astrojs/starlight": "^0.42.6",
    "astro": "^7.4.2",
    "mermaid": "^12.2.0",
    "sharp": "^0.35.5"
  },
  "overrides": {
    "uuid": "^14.0.0",
    "esbuild": "^0.28.1",
    "vite": "8.3.5",
    "dompurify": "3.4.17",
    "nanoid": "^3.3.18",
    "js-yaml": "^4.3.2",
    "smol-toml": "1.9.1",
    "postcss": "^8.5.30",
    "svgo": "^4.1.0",
    "brace-expansion": "^5.0.12",
    "devalue": "6.0.3",
    "undici": "8.11.2",
    "source-map-js": "1.2.2",
    "postcss-nested": "7.0.2",
    "postcss-selector-parser": "7.1.6",
    "http-cache-semantics": "4.3.0",
    "katex": "$katex"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "^10.12.0",
    "happy-dom": "^21.0.4",
    "katex": "^0.19.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "vitest": "^5.0.4"
