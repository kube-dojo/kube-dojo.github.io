---
/**
 * Standalone layout for Daily Dojo.
 * Intentionally bypasses Starlight's default <Head> and omits GoatCounter (/count.js)
 * so /daily/ emits zero analytics requests (kube-dojo #3919).
 */
import Header from '../components/Header.astro';
import ThemeProvider from '@astrojs/starlight/components/ThemeProvider.astro';
import '~starlight-style/layers.css';
import '~starlight-style/props.css';
import '~starlight-style/util.css';
import { DAILY_FEATURE_NAME, DAILY_ROUTE } from '../data/daily/cka-module-5.1';

interface Props {
  title: string;
  description: string;
  canonical?: string;
}

const {
  title,
  description,
  canonical = new URL(DAILY_ROUTE, Astro.site ?? 'https://kube-dojo.github.io').href,
} = Astro.props;
---
<!doctype html>
<html lang="en" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="shortcut icon" href="/favicon.svg" type="image/svg+xml" />
  <style is:global>
    :root {
      --kube-blue: #326CE5;
      --kube-blue-light: #EBF1FF;
      --kube-blue-dark: #1A3A7A;
      --terminal-green: #00E676;
      --terminal-green-light: #E8FFF0;
      --terminal-green-dark: #008A43;
      --danger-red: #D91B3D;
      --danger-red-light: #FFEBEE;
      --warning-amber-dark: #9A5B00;
      --warning-amber-light: #FFF8E1;
      --g50: #FAFBFC;
      --g100: #F3F4F6;
      --g200: #E5E7EB;
      --g300: #D1D5DB;
      --g400: #9CA3AF;
      --g500: #6B7280;
      --g600: #4B5563;
      --g700: #374151;
      --g800: #1F2937;
      --g900: #0F172A;
      --radius: 12px;
      --radius-sm: 8px;
      --mono: 'SF Mono', 'Fira Code', 'JetBrains Mono', Consolas, monospace;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Inter', 'Segoe UI', system-ui, sans-serif;
      color: var(--g900);
      background: var(--g50);
      line-height: 1.65;
      -webkit-font-smoothing: antialiased;
    }
    a { color: var(--kube-blue); text-decoration: none; }
    a:hover { text-decoration: underline; }

    .dd-hero {
      background: linear-gradient(135deg, var(--g900) 0%, #1a2744 55%, var(--kube-blue-dark) 100%);
      color: white;
      padding: 2.5rem 1.5rem 2rem;
    }
    .dd-hero-inner, .dd-main, .dd-footer-inner {
      max-width: 66rem;
      margin: 0 auto;
    }
    .dd-kicker {
      display: inline-block;
      font-family: var(--mono);
      font-size: 0.75rem;
      font-weight: 600;
      color: var(--terminal-green);
      background: rgba(0, 230, 118, 0.12);
      border: 1px solid rgba(0, 230, 118, 0.3);
      border-radius: 999px;
      padding: 0.2rem 0.75rem;
      margin-bottom: 0.75rem;
    }
    .dd-hero h1 {
      font-size: clamp(1.75rem, 3vw, 2.35rem);
      font-weight: 800;
      letter-spacing: -0.02em;
      line-height: 1.15;
      margin-bottom: 0.5rem;
    }
    .dd-hero-sub {
      color: rgba(255, 255, 255, 0.8);
      font-size: 0.975rem;
      max-width: 44rem;
      margin-bottom: 0.75rem;
    }
    .dd-privacy-note {
      font-size: 0.8125rem;
      color: rgba(255, 255, 255, 0.68);
    }

    .dd-main {
      padding: 1.75rem 1.5rem 3.5rem;
      display: grid;
      gap: 1.25rem;
    }

    .dd-stats {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0.75rem;
    }
    @media (max-width: 44rem) {
      .dd-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }
    .dd-stat {
      background: white;
      border: 1px solid var(--g200);
      border-radius: var(--radius-sm);
      padding: 0.875rem 1rem;
      display: flex;
      flex-direction: column;
      gap: 0.125rem;
    }
    .dd-stat-value {
      font-family: var(--mono);
      font-size: 1.25rem;
      font-weight: 800;
      color: var(--g900);
    }
    .dd-stat-label {
      font-size: 0.75rem;
      color: var(--g500);
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    .dd-gentle-note {
      grid-column: 1 / -1;
      background: var(--kube-blue-light);
      color: var(--kube-blue-dark);
      border-radius: var(--radius-sm);
      padding: 0.65rem 0.9rem;
      font-size: 0.85rem;
      font-weight: 500;
    }

    .dd-alert {
      background: var(--warning-amber-light);
      border: 1px solid #F59E0B;
      border-radius: var(--radius-sm);
      padding: 1rem 1.125rem;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      color: var(--g900);
      font-size: 0.875rem;
    }

    .dd-plan-card {
      background: white;
      border: 1px solid var(--g200);
      border-left: 4px solid var(--kube-blue);
      border-radius: var(--radius);
      padding: 1.125rem 1.25rem;
      display: grid;
      gap: 0.6rem;
    }
    .dd-plan-title {
      font-size: 1.05rem;
      font-weight: 700;
    }
    .dd-plan-desc {
      font-size: 0.9rem;
      color: var(--g600);
    }
    .dd-plan-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.65rem;
      margin-top: 0.25rem;
    }

    .dd-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.6rem 1rem;
      border-radius: var(--radius-sm);
      font-size: 0.875rem;
      font-weight: 600;
      cursor: pointer;
      border: 1px solid transparent;
      transition: background 0.15s, border-color 0.15s;
    }
    .dd-btn-primary {
      background: var(--kube-blue);
      color: white;
    }
    .dd-btn-primary:hover { background: #2657bd; }
    .dd-btn-secondary {
      background: white;
      color: var(--g800);
      border-color: var(--g300);
    }
    .dd-btn-secondary:hover { border-color: var(--kube-blue); color: var(--kube-blue); }

    .dd-workspace {
      display: grid;
      grid-template-columns: 18rem minmax(0, 1fr);
      gap: 1.25rem;
      align-items: start;
    }
    @media (max-width: 56rem) {
      .dd-workspace { grid-template-columns: 1fr; }
    }

    .dd-unit-list {
      list-style: none;
      display: grid;
      gap: 0.45rem;
    }
    .dd-unit-pill {
      width: 100%;
      text-align: left;
      background: white;
      border: 1px solid var(--g200);
      border-radius: var(--radius-sm);
      padding: 0.65rem 0.75rem;
      cursor: pointer;
      display: grid;
      grid-template-columns: 1.65rem minmax(0, 1fr);
      gap: 0.15rem 0.55rem;
      align-items: center;
      color: var(--g900);
      transition: border-color 0.15s, background 0.15s;
    }
    .dd-unit-pill:hover { border-color: var(--kube-blue); }
    .dd-unit-pill.is-active {
      border-color: var(--kube-blue);
      background: var(--kube-blue-light);
    }
    .dd-pill-num {
      grid-row: 1 / 3;
      width: 1.65rem;
      height: 1.65rem;
      border-radius: 6px;
      background: var(--g100);
      color: var(--g700);
      font-family: var(--mono);
      font-size: 0.75rem;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .dd-unit-pill.is-active .dd-pill-num { background: var(--kube-blue); color: white; }
    .dd-unit-pill.is-done .dd-pill-num { background: var(--terminal-green-light); color: var(--terminal-green-dark); }
    .dd-unit-pill.is-due .dd-pill-num { background: var(--warning-amber-light); color: var(--warning-amber-dark); }
    .dd-pill-title { font-size: 0.85rem; font-weight: 600; line-height: 1.3; }
    .dd-pill-badge { font-size: 0.72rem; color: var(--g500); font-family: var(--mono); }
    .dd-unit-pill.is-due .dd-pill-badge { color: var(--warning-amber-dark); font-weight: 700; }

    .dd-lesson {
      background: white;
      border: 1px solid var(--g200);
      border-radius: var(--radius);
      padding: 1.5rem;
      display: grid;
      gap: 1.35rem;
    }
    .dd-lesson-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-bottom: 0.5rem;
    }
    .dd-tag {
      font-family: var(--mono);
      font-size: 0.75rem;
      font-weight: 600;
      padding: 0.2rem 0.6rem;
      border-radius: 6px;
    }
    .dd-tag-num { background: var(--kube-blue-light); color: var(--kube-blue-dark); }
    .dd-tag-time { background: var(--g100); color: var(--g600); }
    .dd-tag-due { background: var(--warning-amber-light); color: var(--warning-amber-dark); }
    .dd-tag-done { background: var(--terminal-green-light); color: var(--terminal-green-dark); }
    .dd-lesson-title { font-size: 1.4rem; font-weight: 800; line-height: 1.25; }

    .dd-section { display: grid; gap: 0.5rem; }
    .dd-section-label {
      font-size: 0.78rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--g500);
    }
    .dd-idea { font-size: 0.975rem; color: var(--g800); }

    .dd-code {
      background: var(--g900);
      color: #E5EDF9;
      padding: 1rem 1.1rem;
      border-radius: var(--radius-sm);
      overflow-x: auto;
      font-family: var(--mono);
      font-size: 0.84rem;
      line-height: 1.6;
    }
    .dd-takeaway {
      font-size: 0.875rem;
      color: var(--g600);
      border-left: 3px solid var(--kube-blue);
      padding-left: 0.75rem;
    }

    .dd-check {
      border: 1px solid var(--g200);
      border-radius: var(--radius-sm);
      padding: 1rem 1.125rem;
      display: grid;
      gap: 0.75rem;
    }
    .dd-check-prompt {
      font-weight: 700;
      font-size: 0.95rem;
      padding: 0 0.25rem;
      color: var(--g900);
    }
    .dd-options { display: grid; gap: 0.5rem; }
    .dd-option {
      text-align: left;
      background: var(--g50);
      border: 1px solid var(--g300);
      border-radius: var(--radius-sm);
      padding: 0.7rem 0.9rem;
      font-size: 0.9rem;
      color: var(--g900);
      cursor: pointer;
      line-height: 1.45;
      transition: border-color 0.15s, background 0.15s;
    }
    .dd-option:hover { border-color: var(--kube-blue); background: var(--kube-blue-light); }
    .dd-option.is-correct {
      border-color: var(--terminal-green-dark);
      background: var(--terminal-green-light);
      color: #064E3B;
      font-weight: 600;
    }
    .dd-option.is-incorrect {
      border-color: var(--danger-red);
      background: var(--danger-red-light);
      color: #7F1D1D;
    }

    .dd-feedback {
      border-radius: var(--radius-sm);
      padding: 0.75rem 0.9rem;
      font-size: 0.875rem;
      line-height: 1.55;
    }
    .dd-feedback-correct {
      background: var(--terminal-green-light);
      border: 1px solid rgba(0, 138, 67, 0.35);
      color: #064E3B;
    }
    .dd-feedback-incorrect {
      background: var(--danger-red-light);
      border: 1px solid rgba(217, 27, 61, 0.35);
      color: #7F1D1D;
    }
    .dd-feedback-hint {
      margin-top: 0.45rem;
      font-size: 0.8125rem;
      opacity: 0.9;
    }

    .dd-result {
      border-radius: var(--radius-sm);
      padding: 1rem 1.125rem;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
    }
    .dd-result-pass {
      background: var(--terminal-green-light);
      border: 1px solid var(--terminal-green-dark);
      color: #064E3B;
    }
    .dd-result-review {
      background: var(--warning-amber-light);
      border: 1px solid #F59E0B;
      color: var(--g900);
    }
    .dd-result-text { font-size: 0.9rem; font-weight: 600; }

    .dd-lesson-footer {
      border-top: 1px solid var(--g200);
      padding-top: 1.125rem;
      display: grid;
      gap: 0.85rem;
    }
    .dd-deep-links {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.75rem;
    }
    @media (max-width: 40rem) {
      .dd-deep-links { grid-template-columns: 1fr; }
    }
    .dd-link-card {
      border: 1px solid var(--g200);
      border-radius: var(--radius-sm);
      padding: 0.75rem 0.9rem;
      display: flex;
      flex-direction: column;
      gap: 0.15rem;
      background: var(--g50);
      color: var(--g900);
    }
    .dd-link-card:hover {
      border-color: var(--kube-blue);
      background: var(--kube-blue-light);
      text-decoration: none;
    }
    .dd-link-kicker { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--g500); }
    .dd-link-main { font-size: 0.875rem; font-weight: 700; color: var(--kube-blue-dark); }
    .dd-sources { font-size: 0.8125rem; color: var(--g500); }
    .dd-sources-label { font-weight: 600; color: var(--g600); }

    .dd-footer {
      background: var(--g900);
      color: var(--g400);
      padding: 1.75rem 1.5rem;
      font-size: 0.8125rem;
      text-align: center;
    }
    .dd-footer a { color: #93B4F5; }

    /* Dark mode */
    html[data-theme='dark'] body { background: var(--g900); color: var(--g100); }
    html[data-theme='dark'] .dd-stat,
    html[data-theme='dark'] .dd-plan-card,
    html[data-theme='dark'] .dd-unit-pill,
    html[data-theme='dark'] .dd-lesson,
    html[data-theme='dark'] .dd-check {
      background: var(--g800);
      border-color: var(--g700);
      color: var(--g100);
    }
    html[data-theme='dark'] .dd-stat-value,
    html[data-theme='dark'] .dd-check-prompt,
    html[data-theme='dark'] .dd-idea { color: var(--g100); }
    html[data-theme='dark'] .dd-plan-desc,
    html[data-theme='dark'] .dd-takeaway,
    html[data-theme='dark'] .dd-sources,
    html[data-theme='dark'] .dd-sources-label,
    html[data-theme='dark'] .dd-pill-badge { color: var(--g400); }
    html[data-theme='dark'] .dd-btn-secondary,
    html[data-theme='dark'] .dd-option,
    html[data-theme='dark'] .dd-link-card {
      background: var(--g900);
      border-color: var(--g700);
      color: var(--g100);
    }
    html[data-theme='dark'] .dd-unit-pill.is-active {
      background: rgba(50, 108, 229, 0.2);
      border-color: #60A5FA;
    }
    html[data-theme='dark'] .dd-link-main { color: #93B4F5; }
    html[data-theme='dark'] .dd-pill-num { background: var(--g700); color: var(--g200); }
    html[data-theme='dark'] .dd-tag-num { background: rgba(50, 108, 229, 0.25); color: #93B4F5; }
    html[data-theme='dark'] .dd-tag-time { background: var(--g700); color: var(--g200); }
    html[data-theme='dark'] .dd-lesson-footer { border-top-color: var(--g700); }
  </style>
  <ThemeProvider />
</head>
<body>
  <Header standalone />
  <slot />
  <footer class="dd-footer">
    <div class="dd-footer-inner">
      <p>
        {DAILY_FEATURE_NAME} · Progress is stored only in your browser (<code class="dd-inline-code">localStorage</code>) with zero analytics. ·
        <a href="/">Home</a> ·
        <a href="/k8s/cka/part5-troubleshooting/module-5.1-methodology/">Full CKA Module 5.1</a>
      </p>
    </div>
  </footer>
</body>
</html>
