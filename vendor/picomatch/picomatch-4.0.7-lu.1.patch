+// learn-ukrainian patch for GHSA-fc5q-39xc-vjpf (CVE-2026-112366), see
+// site/vendor/picomatch/README.md in learn-ukrainian. A repeated extglob, `+(...)` or `*(...)`, backtracks
+// exponentially when one iteration can consume a variable number of
+// characters (`+(*)`, `+(*a)`, `+(a+)`, nested extglobs) or when two
+// branches can match the same text (`+(a|ab|b)`). These helpers fail
+// closed: a body they cannot prove safe is literalized by extglobClose,
+// exactly as the upstream guard already does for `*(*|x)`.
+
+const unwrapAtGroups = branch => {
+  let value = branch;
+
+  while (/^@\([^\\()[\]{}|]+\)$/.test(value)) {
+    value = value.slice(2, -1);
+  }
+
+  return value;
+};
+
+// Fixed width: only literal characters, `?` and bracket expressions, so every
+// iteration consumes the same number of characters. Any quantifier, group,
+// brace or quote fails the check, and so does any backslash: the tokenizer
+// collapses backslash runs and can then emit a following `?` as a regex
+// quantifier, so escapes are not modelled here.
+const isFixedWidthBranch = branch => !/[\\*+(){}|"]/.test(unwrapAtGroups(branch));
+
+// Bounds the decodability test below so that analysing a pattern stays cheap.
+const MAX_ALTERNATION_CHARS = 1024;
+
+// Several branches are safe to repeat only when each is a non-empty literal and
+// the branch set is uniquely decodable (Sardinas-Patterson test): then every
+// prefix of the input has at most one split into branches, so backtracking
+// visits each input position at most once. When some text has two splits
+// (`a|ab|b` on "ab"), each repetition doubles the work. The test must run on
+// the text the regex matches, so a branch may hold only characters that the
+// tokenizer emits as exactly themselves: ASCII letters and digits and a few
+// plain punctuation marks. Anything else, such as a backslash (`\w` keeps its
+// regex meaning), a NUL (the tokenizer drops it), a comma or a non-ASCII
+// character, fails closed. Under case-insensitive matching the branches are
+// compared lower-cased.
+const LITERAL_BRANCH = /^[A-Za-z0-9 _.~#%&'/:;<=>-]+$/;
+
+const isUnambiguousLiteralAlternation = (branches, caseless) => {
+  const code = new Set();
+  let size = 0;
+
+  for (const branch of branches) {
+    const value = unwrapAtGroups(branch);
+
+    if (!LITERAL_BRANCH.test(value)) {
+      return false;
+    }
+
+    const literal = caseless ? value.toLowerCase() : value;
+    size += literal.length;
+
+    if (code.has(literal) || size > MAX_ALTERNATION_CHARS) {
+      return false;
+    }
+
+    code.add(literal);
+  }
+
+  const danglingSuffixes = (words, others) => {
+    const suffixes = new Set();
+
+    for (const u of words) {
+      for (const v of others) {
+        if (u !== v && v.startsWith(u)) {
+          suffixes.add(v.slice(u.length));
+        }
+      }
+    }
+
+    return suffixes;
+  };
+
+  const seen = new Set();
+  let current = danglingSuffixes(code, code);
+
+  while (current.size > 0) {
+    const fresh = [...current].filter(suffix => !seen.has(suffix));
+
+    if (fresh.some(suffix => code.has(suffix))) {
+      return false;
+    }
+
+    fresh.forEach(suffix => seen.add(suffix));
+    current = new Set([...danglingSuffixes(fresh, code), ...danglingSuffixes(code, fresh)]);
+  }
+
+  return true;
+};
